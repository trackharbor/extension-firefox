{
  "manifest_version": 2,
  "name": "TrackHarbor Spotify Headers",
  "version": "1.0.0",
  "description": "Копирует заголовки вашей сессии Spotify для ручной авторизации в TrackHarbor.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spotify-headers@trackharbor.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest",
    "clipboardWrite",
    "https://open.spotify.com/*",
    "https://api-partner.spotify.com/*"
  ],
  "background": { "page": "background.html", "persistent": true },
  "icons": { "48": "icons/spotify-headers.svg", "96": "icons/spotify-headers.svg" },
  "browser_action": {
    "default_title": "Скопировать заголовки Spotify для TrackHarbor",
    "default_icon": "icons/spotify-headers.svg"
  }
}
